<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base -->
    <style name="Theme.MonitorWhatsApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Cores primárias -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Cores secundárias -->
        <item name="colorSecondary">@color/background_card</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Texto -->
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- Tema para TextInputLayout -->
    <style name="ThemeOverlay.MonitorWhatsApp.TextInputLayout" parent="">
        <item name="colorControlActivated">@color/primary_blue</item>
        <item name="colorControlNormal">@color/text_hint</item>
        <item name="colorControlHighlight">@color/primary_blue</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
</resources>